# ─────────────────────────────────────────────────────────────────────────────
# StrikeEdge — CONSERVATIVE MUMBAI EC2 PROFILE (ap-south-1)
#
# Copy to .env and edit the marked values. See docs/MUMBAI_EC2_PROFILE.md for the
# reasoning behind every number, and docs/CONFIGURATION.md for the full variable list.
#
# REAL TRADING IS DISABLED IN THIS FILE. Two independent switches must both be set
# before any real order can be placed, and BOX_EXECUTION_MODE=live is REJECTED AT BOOT
# unless BOX_LIVE_TRADING_ENABLED=true — so a single stray variable cannot arm live.
#
# Values marked (default) match the shipped code default; they are written out anyway
# so the intended posture is explicit rather than inherited.
# ─────────────────────────────────────────────────────────────────────────────

# ── EXECUTION MODE ───────────────────────────────────────────────────────────
BOX_EXECUTION_MODE=paper_latency          # (default) flip to `live` only when supervised
BOX_LIVE_TRADING_ENABLED=false            # (default) deployment kill switch

# ── SIZE: one lot, one box ───────────────────────────────────────────────────
BOX_LIVE_MAX_OPEN_BOXES=1                 # (default)
BOX_LIVE_MAX_CONCURRENT_EXECUTIONS=1      # (default)
BOX_ONE_ACTIVE_BOX_PER_UNDERLYING=true    # ON (code default is false)
BOX_SESSION_MAX_COMPLETED_TRADES=1        # explicitly armed one-box session (default 0 = unlimited)

# ── ENTRY TRANSPORT CONCURRENCY ──────────────────────────────────────────────
# Keep 1. The offline benchmark shows 2 and 4 do not materially help: the broker
# pacing floor plus the hedge-first dependency binds. Concurrency 4 does NOT make
# four-leg execution atomic.
BOX_LIVE_ENTRY_SUBMIT_CONCURRENCY=1       # (default; min 1, max 4)

# ── CAPITAL: GROSS ORDER NOTIONAL — not margin, not peak capital, not max loss ─
# Code default is 0 = DISABLED. EDIT THIS before going live.
BOX_LIVE_MAX_BOX_CAPITAL_RUPEES=500000

# ── LOSS BREAKER — stops NEW entries; NOT a guaranteed maximum loss ───────────
BOX_LIVE_DAILY_LOSS_LIMIT=5000            # (default)

# ── FRESHNESS ────────────────────────────────────────────────────────────────
BOX_QUOTE_MAX_AGE_MS=15000                # (default) per-leg book age ceiling
BOX_FEED_MAX_AGE_MS=5000                  # (default) whole-universe feed liveness
BOX_UNDERLYING_MAX_AGE_MS=10000           # (default)

# ── FOUR-LEG COHERENCE ───────────────────────────────────────────────────────
# RECEIVE-time dispersion is the always-available gate: Dhan publishes NO order-book
# timestamp, and Kite's is 1-second granular.
BOX_MAX_CROSS_LEG_RECEIVE_DISPERSION_MS=500        # (default)
# EXCHANGE-time dispersion applies only when EVERY leg has a real book timestamp.
# PRECISION TRAP: Kite's stamp is whole SECONDS, so <1000 can reject coherent books on
# quantisation alone. Code default is 250, which is BELOW Kite precision — raised here.
BOX_MAX_CROSS_LEG_EXCHANGE_DISPERSION_MS=1000
BOX_MAX_RECEIVE_TO_EXCHANGE_DELAY_MS=5000          # (default)
# In LIVE a 0 dispersion limit is IMPOSSIBLE-TO-SATISFY, not a silent bypass. Keep false
# so an unconfigured operator can never accidentally lose cross-leg enforcement.
BOX_COHERENCE_ZERO_DISPERSION_DISABLES_IN_LIVE=false   # (default)

# ── ORDER-UPDATE STREAMS: off, and NOT WIRED in this build ───────────────────
# No running component consumes the order-update stream, so fills are observed by REST
# polling only. /api/box/status .order_stream reports `not_wired` / `rest_polling_only`.
# Setting these true does NOT start a consumer. Believe the status, not the capability.
ZERODHA_ORDER_STREAM_ENABLED=false        # (default)
DHAN_ORDER_STREAM_ENABLED=false           # (default)

# ── POSTGRESQL — authoritative operational state, same EC2 host ──────────────
# Do NOT set synchronous_commit=off; durability before transport is load-bearing.
DATABASE_URL=postgres:///strikedge
PG_POOL_MAX=10                            # (default)
PG_STATEMENT_TIMEOUT_MS=5000              # (default)
PG_LOCK_TIMEOUT_MS=2000                   # (default)
PG_MIGRATE_ON_BOOT=true                   # (default)
PG_APPLICATION_NAME=strikedge             # (default)

# ── MongoDB Atlas — ASYNCHRONOUS projection only, never awaited on the order path ─
MONGODB_URI=

# ── OPERATIONAL PRECONDITIONS (not enforceable in code) ──────────────────────
# 1. Elastic IP or NAT with a fixed EIP, registered with BOTH brokers.
# 2. chrony against Amazon Time Sync (169.254.169.123); verify `chronyc tracking`.
# 3. CalSpread Box execution DISABLED before arming StrikeEdge live on a shared
#    account. Order-rate budgets are shared and neither app can see the other's
#    requests. This needs operational coordination; code cannot detect it.
