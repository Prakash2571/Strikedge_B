{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "box-status.schema.json",
  "title": "GET /api/box/status (200)",
  "description": "The Box engine status the dashboard polls. Source: src/box/engine.ts getStatus(). Obtained via a DIRECT call to the REAL BoxEngine.getStatus() on a hermetically-constructed engine (inert deps, no I/O): the /api/box/status registrar does res.json(engine.getStatus()), so the method is the authoritative producer of the wire bytes. TOP LEVEL is CLOSED so an added/removed/renamed headline field is caught. The bounded diagnostic sub-objects (scanner/monitor/charges/reconciliation/metrics/day_pnl/executable_book_diagnostics/risk_bookkeeping) are engine-owned observability rings whose internal field churn is not part of the frontend contract; each is pinned as an OPEN object (presence + object-ness) with a $comment. `config` re-uses the closed box-config contract. `live_manager` is null in paper and an engine-owned live snapshot otherwise, so it is OPEN/null.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "running",
    "state",
    "monitoring",
    "market_open",
    "indicative_at",
    "indicative_priced",
    "indicative_session_day",
    "indicative_stale_legs",
    "execution_mode",
    "broker",
    "brokers_with_open_positions",
    "authenticated",
    "broker_auth_healthy",
    "broker_orders_api_healthy",
    "broker_positions_api_healthy",
    "market_data_healthy",
    "database_healthy",
    "daily_risk_seed_healthy",
    "reconciliation_complete",
    "unknown_orders",
    "recovery_active",
    "circuit_state",
    "live_manager",
    "db_enabled",
    "started_at",
    "stopped_at",
    "universe_built_at",
    "strike_level",
    "underlyings",
    "candidates",
    "monitored_tokens",
    "subscribed_option_tokens",
    "subscribed_spot_tokens",
    "hub_subscribed",
    "hub_connected",
    "quotes",
    "quote_updates",
    "feed_age_ms",
    "raw_tick_age_ms",
    "book_observation_age_ms",
    "executable_books",
    "executable_book_diagnostics",
    "feed_healthy",
    "exchange_lag_ms",
    "open_positions",
    "degraded",
    "pending_unpersisted_fills",
    "owned_unpersisted",
    "residual_exposure_count",
    "residual_exposure_legs",
    "residual_flatten_in_flight",
    "risk_bookkeeping",
    "partially_exited_positions",
    "day_pnl",
    "skipped_for_budget",
    "skipped_symbols",
    "skipped_indicative_cap",
    "skipped_indicative_symbols",
    "indicative_max_underlyings",
    "scanner",
    "monitor",
    "charges",
    "reconciliation",
    "metrics",
    "last_error",
    "config",
    "order_stream",
    "execution_funnel",
    "economic_admission"
  ],
  "properties": {
    "running": {
      "type": "boolean"
    },
    "state": {
      "enum": [
        "SCANNING",
        "MARKET_CLOSED",
        "STOPPED"
      ]
    },
    "monitoring": {
      "type": "boolean"
    },
    "market_open": {
      "type": "boolean"
    },
    "indicative_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "indicative_priced": {
      "type": [
        "number",
        "null"
      ]
    },
    "indicative_session_day": {
      "type": [
        "string",
        "null"
      ]
    },
    "indicative_stale_legs": {
      "type": [
        "number",
        "null"
      ]
    },
    "execution_mode": {
      "type": "string"
    },
    "broker": {
      "enum": [
        "zerodha",
        "dhan"
      ]
    },
    "brokers_with_open_positions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authenticated": {
      "type": "boolean"
    },
    "broker_auth_healthy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "broker_orders_api_healthy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "broker_positions_api_healthy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "market_data_healthy": {
      "type": "boolean"
    },
    "order_stream": {
      "$ref": "order-stream-status.schema.json",
      "$comment": "Order-update stream status. NOT market-data health: a healthy tick feed is no evidence that fills are observed promptly. See order-stream-status.schema.json."
    },
    "execution_funnel": {
      "$comment": "OPEN by design (Task 8): the execution funnel snapshot — outcome counts with explicit denominators, incremented from real execution events. An engine-owned observability ring whose internal field set is not part of the strict frontend contract; pinned as presence + object-ness. Source: ExecutionFunnel.snapshot().",
      "type": "object"
    },
    "economic_admission": {
      "$comment": "OPEN by design (Task 8): the last economic-admission decision (five distinct quantities with provenance), or null when no economic control is enabled. Source: CentralBoxExecutionGateway.economicDiagnostics().",
      "type": [
        "object",
        "null"
      ]
    },
    "database_healthy": {
      "type": "boolean"
    },
    "daily_risk_seed_healthy": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "reconciliation_complete": {
      "type": "boolean"
    },
    "unknown_orders": {
      "type": "number"
    },
    "recovery_active": {
      "type": "boolean"
    },
    "circuit_state": {
      "type": "string"
    },
    "live_manager": {
      "$comment": "OPEN by design: null in paper, an engine-owned live-order-manager snapshot otherwise.",
      "type": [
        "object",
        "null"
      ]
    },
    "db_enabled": {
      "type": "boolean"
    },
    "started_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "stopped_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "universe_built_at": {
      "type": [
        "number",
        "null"
      ]
    },
    "strike_level": {
      "type": "number"
    },
    "underlyings": {
      "type": "number"
    },
    "candidates": {
      "type": "number"
    },
    "monitored_tokens": {
      "type": "number"
    },
    "subscribed_option_tokens": {
      "type": "number"
    },
    "subscribed_spot_tokens": {
      "type": "number"
    },
    "hub_subscribed": {
      "type": "number"
    },
    "hub_connected": {
      "type": "boolean"
    },
    "quotes": {
      "type": "number"
    },
    "quote_updates": {
      "type": "number"
    },
    "feed_age_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "raw_tick_age_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "book_observation_age_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "executable_books": {
      "type": "number"
    },
    "executable_book_diagnostics": {
      "$comment": "OPEN by design: engine-owned book-health counters.",
      "type": "object"
    },
    "feed_healthy": {
      "type": "boolean"
    },
    "exchange_lag_ms": {
      "type": [
        "number",
        "null"
      ]
    },
    "open_positions": {
      "type": "number"
    },
    "degraded": {
      "type": "boolean"
    },
    "pending_unpersisted_fills": {
      "type": "number"
    },
    "owned_unpersisted": {
      "type": "number"
    },
    "residual_exposure_count": {
      "type": "number"
    },
    "residual_exposure_legs": {
      "type": "number"
    },
    "residual_flatten_in_flight": {
      "type": "number"
    },
    "risk_bookkeeping": {
      "$comment": "OPEN by design: bounded per-attempt risk bookkeeping (observability only).",
      "type": "object"
    },
    "partially_exited_positions": {
      "type": "number"
    },
    "day_pnl": {
      "$comment": "OPEN by design: engine-owned running day-P&L aggregate.",
      "type": "object"
    },
    "skipped_for_budget": {
      "type": "number"
    },
    "skipped_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped_indicative_cap": {
      "type": "number"
    },
    "skipped_indicative_symbols": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "indicative_max_underlyings": {
      "type": "number"
    },
    "scanner": {
      "$comment": "OPEN by design: engine-owned scanner counters.",
      "type": "object"
    },
    "monitor": {
      "$comment": "OPEN by design: engine-owned monitor counters.",
      "type": "object"
    },
    "charges": {
      "$comment": "OPEN by design: engine-owned charge-estimator counters.",
      "type": "object"
    },
    "reconciliation": {
      "$comment": "OPEN by design: engine-owned reconciliation counters.",
      "type": "object"
    },
    "metrics": {
      "$comment": "OPEN by design: engine-owned rolling latency/slippage/throughput rings.",
      "type": "object"
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "config": {
      "$ref": "box-config.schema.json"
    }
  }
}
