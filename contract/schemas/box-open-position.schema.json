{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "box-open-position.schema.json",
  "title": "A live open Box position with current exit arithmetic",
  "description": "One element of open-trades.open and snapshot.open_trades. Source: src/box/engine.ts getOpenPositions(). Obtained via a DIRECT call to REAL BoxEngine.getOpenPositions() with a position whose metrics were computed by the REAL BoxPositionMonitor.measure() over a real quote store. CLOSED at top level and both leg arrays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "key", "underlying", "name", "is_index", "expiry", "direction", "lower_strike",
    "upper_strike", "box_width", "lot_size", "quantity", "opened_at", "margin", "entry_box_cost",
    "entry_gross_edge", "entry_charges", "estimated_exit_charges_at_entry", "safety_buffer",
    "entry_net_edge", "expected_net_profit", "entry_execution_cost", "charge_origin", "entry_legs",
    "exit_legs", "exit_box_value", "gross_pnl", "current_exit_charges", "total_charges", "net_pnl",
    "realisable_net_pnl", "estimated_execution_cost", "remaining_edge", "entry_edge",
    "captured_edge", "captured_pct", "time_in_trade_ms", "convergence_threshold",
    "min_exit_net_pnl", "profit_capture_target", "min_captured_pct", "liquidity_ok", "worst_age_ms",
    "exit_eligible", "exit_reason", "exit_rule_reason", "blocked_reason", "exit_blocked_reason",
    "expiry_safety", "status", "execution_mode", "broker"
  ],
  "properties": {
    "id": { "type": "string" },
    "key": { "type": "string" },
    "execution_mode": { "type": "string" },
    "broker": { "enum": ["zerodha", "dhan"] },
    "underlying": { "type": "string" },
    "name": { "type": "string" },
    "is_index": { "type": "boolean" },
    "expiry": { "type": "string" },
    "direction": { "enum": ["LONG_BOX", "SHORT_BOX"] },
    "lower_strike": { "type": "number" },
    "upper_strike": { "type": "number" },
    "box_width": { "type": "number" },
    "lot_size": { "type": "number" },
    "quantity": { "type": "number" },
    "opened_at": { "type": "string", "format": "date-time" },
    "margin": { "type": ["number", "null"] },
    "entry_box_cost": { "type": ["number", "null"] },
    "entry_gross_edge": { "type": ["number", "null"] },
    "entry_charges": { "type": ["number", "null"] },
    "estimated_exit_charges_at_entry": { "type": ["number", "null"] },
    "safety_buffer": { "type": "number" },
    "entry_net_edge": { "type": ["number", "null"] },
    "expected_net_profit": { "type": ["number", "null"] },
    "entry_execution_cost": { "type": ["number", "null"] },
    "charge_origin": { "type": "string" },
    "entry_legs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "side", "tradingsymbol", "strike", "instrument_type", "entry_price"],
        "properties": {
          "role": { "enum": ["k1_ce", "k2_ce", "k2_pe", "k1_pe"] },
          "side": { "enum": ["BUY", "SELL"] },
          "tradingsymbol": { "type": "string" },
          "strike": { "type": "number" },
          "instrument_type": { "enum": ["CE", "PE"] },
          "entry_price": { "type": ["number", "null"] }
        }
      }
    },
    "exit_legs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "side", "tradingsymbol", "price", "bid", "bid_qty", "ask", "ask_qty", "age_ms", "executable", "fresh"],
        "properties": {
          "role": { "enum": ["k1_ce", "k2_ce", "k2_pe", "k1_pe"] },
          "side": { "enum": ["BUY", "SELL"] },
          "tradingsymbol": { "type": "string" },
          "price": { "type": ["number", "null"] },
          "bid": { "type": ["number", "null"] },
          "bid_qty": { "type": ["number", "null"] },
          "ask": { "type": ["number", "null"] },
          "ask_qty": { "type": ["number", "null"] },
          "age_ms": { "type": ["number", "null"] },
          "executable": { "type": "boolean" },
          "fresh": { "type": "boolean" }
        }
      }
    },
    "exit_box_value": { "type": ["number", "null"] },
    "gross_pnl": { "type": ["number", "null"] },
    "current_exit_charges": { "type": ["number", "null"] },
    "total_charges": { "type": ["number", "null"] },
    "net_pnl": { "type": ["number", "null"] },
    "realisable_net_pnl": { "type": ["number", "null"] },
    "estimated_execution_cost": { "type": ["number", "null"] },
    "remaining_edge": { "type": ["number", "null"] },
    "entry_edge": { "type": ["number", "null"] },
    "captured_edge": { "type": ["number", "null"] },
    "captured_pct": { "type": ["number", "null"] },
    "time_in_trade_ms": { "type": ["number", "null"] },
    "convergence_threshold": { "type": ["number", "null"] },
    "min_exit_net_pnl": { "type": ["number", "null"] },
    "profit_capture_target": { "type": ["number", "null"] },
    "min_captured_pct": { "type": ["number", "null"] },
    "liquidity_ok": { "type": "boolean" },
    "worst_age_ms": { "type": ["number", "null"] },
    "exit_eligible": { "type": "boolean" },
    "exit_reason": { "type": ["string", "null"] },
    "exit_rule_reason": { "type": ["string", "null"] },
    "blocked_reason": { "type": ["string", "null"] },
    "exit_blocked_reason": { "type": ["string", "null"] },
    "expiry_safety": { "type": "boolean" },
    "status": { "const": "open" }
  }
}
