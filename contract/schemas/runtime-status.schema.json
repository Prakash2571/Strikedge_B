{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-status.schema.json",
  "title": "GET /api/runtime/status (200)",
  "description": "Operator runtime health. Source: src/runtime/statusRoutes.ts RuntimeStatusSnapshot. Obtained via REAL HTTP against the real registrar with an inert RuntimeStatusProvider. NO SECRETS: states, counts, ages, timestamps and redacted errors only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brokers",
    "active_broker",
    "pg_ready",
    "migration_state",
    "recovery_ready",
    "live_entry",
    "recovery_pending",
    "residual_exposure"
  ],
  "properties": {
    "brokers": { "type": "array", "items": { "$ref": "broker-runtime-status.schema.json" } },
    "active_broker": { "type": ["string", "null"], "enum": ["zerodha", "dhan", null] },
    "pg_ready": { "type": "boolean" },
    "migration_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "pending"],
      "properties": {
        "applied": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 }
      }
    },
    "recovery_ready": { "type": "boolean" },
    "live_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked", "reasons"],
      "properties": {
        "blocked": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "recovery_pending": { "type": "boolean" },
    "residual_exposure": { "type": "boolean" }
  }
}
