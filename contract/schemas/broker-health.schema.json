{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "broker-health.schema.json",
  "title": "Redacted broker health descriptor",
  "description": "Source: src/brokerRoutes.ts BrokerHealth. States and problem strings only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["broker", "authenticated", "data_ready", "trading_ready", "problems"],
  "properties": {
    "broker": { "enum": ["zerodha", "dhan"] },
    "authenticated": { "type": "boolean" },
    "data_ready": { "type": "boolean" },
    "trading_ready": { "type": "boolean" },
    "problems": { "type": "array", "items": { "type": "string" } }
  }
}
